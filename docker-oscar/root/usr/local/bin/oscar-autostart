#!/bin/bash

# Persistent log file in the user data volume
SHUTDOWN_LOG="/config/Documents/OSCAR_Data/shutdown.log"
touch "$SHUTDOWN_LOG"
exec >> "$SHUTDOWN_LOG" 2>&1

echo "--- OSCAR Autostart Service started at $(date) ---"

# Set display
export DISPLAY="${DISPLAY:-:1}"
echo "Using DISPLAY=$DISPLAY"

# Wait for Selkies log to exist
LOG_FILE="/tmp/selkies.log"
echo "Waiting for $LOG_FILE..."
while [ ! -f "$LOG_FILE" ]; do
  sleep 1
done

echo "Selkies log found. Waiting for client connection and resolution stabilization..."
# Use tail -n +1 to ensure we don't miss a message that happened just before we started tailing
# Use specific patterns to avoid false positives from startup warnings (like "no clients connected")
MATCH_PATTERN="Stream settings active|Primary client connected|Connected to"
MATCH=$(tail -n +1 -F "$LOG_FILE" | grep -Ei -m 1 "$MATCH_PATTERN")

echo "Client connection detected via log match: \"$MATCH\" at $(date). Launching OSCAR..."

# Ensure only one instance runs
if pgrep -u abc OSCAR > /dev/null; then
  echo "OSCAR is already running. Exiting script."
  exit 0
fi

/usr/bin/OSCAR &
OSCAR_PID=$!
echo "OSCAR started with PID: $OSCAR_PID at $(date)"

graceful_stop() {
  echo "Caught termination signal at $(date). Starting graceful shutdown..."
  
  # Method 1: Signal OSCAR's window to close (mimics File > Exit)
  echo "Attempting to close OSCAR window via xdotool..."
  # We search for windows owned by 'abc' and containing 'OSCAR' in the name
  /usr/bin/xdotool search --all --name "OSCAR" windowclose
  
  # Wait and monitor
  MAX_WAIT=10
  WAIT_COUNT=0
  while pgrep -u abc OSCAR > /dev/null && [ $WAIT_COUNT -lt $MAX_WAIT ]; do
    sleep 1
    ((WAIT_COUNT++))
    echo "Waiting for OSCAR (PID $OSCAR_PID) to exit... ($WAIT_COUNT/$MAX_WAIT)"
  done

  # Method 2: Fallback to SIGINT if still running
  if pgrep -u abc OSCAR > /dev/null; then
    echo "OSCAR still running after $MAX_WAIT seconds. Sending SIGINT..."
    kill -SIGINT $OSCAR_PID
    
    # Final brief wait
    sleep 3
  fi

  if pgrep -u abc OSCAR > /dev/null; then
      echo "OSCAR failed to exit gracefully. Forcing kill..."
      kill -9 $OSCAR_PID
  else
      echo "OSCAR has exited at $(date)."
  fi
  
  echo "Shutdown sequence complete."
  exit 0
}

# Trap signals from s6-overlay
trap graceful_stop TERM INT

# Wait for the background process
wait $OSCAR_PID
echo "OSCAR process finished naturally at $(date)."
